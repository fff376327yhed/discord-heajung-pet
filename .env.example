# 이 파일을 복사해서 ".env" 라는 이름으로 만들고 값을 채워주세요! (.env는 절대 깃허브에 올리면 안 돼요)
# 디스코드 개발자 포털(https://discord.com/developers/applications)에서 찾을 수 있어요.

DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# (선택) 내 테스트 서버 ID를 넣으면 명령어가 바로바로 반영돼요
DISCORD_GUILD_ID=

# 아래 FIREBASE 값은 Vercel 환경변수에만 넣으면 돼요 (내 컴퓨터 .env엔 안 넣어도 OK)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ... 한 줄로 ...}
